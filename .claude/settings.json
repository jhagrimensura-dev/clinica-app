{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/session-pull.mjs\"",
            "timeout": 30,
            "statusMessage": "git pull..."
          }
        ]
      }
    ]
  }
}
